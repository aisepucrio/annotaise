# Copy this file to .env (cp .env.example .env) and adjust the values.
# The defaults below are enough to run AnnotAISE locally with Docker.

# --- Mode ---
# Backend: "false" runs gunicorn with collected static files; anything else runs the dev server.
DEBUG=true
# Frontend: "false" builds and runs Next.js in production mode; anything else runs `npm run dev`.
DEBUG_NEXT=true

# --- Database (PostgreSQL, also used to create the db container) ---
DJANGO_DB_NAME=annotaise
DJANGO_DB_USER=annotaise
DJANGO_DB_PASS=change-me

# --- Superuser created automatically on the first startup ---
# You log in with this email and password.
DJANGO_SUPERUSER_USER=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Email (invitations and password reset) ---
# EMAIL_PORT must be a number, or the backend fails to start.
# Leave the user and password empty if you are not going to send emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="AnnotAISE <no-reply@example.com>"

# --- URLs ---
# Where the frontend is served; used in invitation and password reset links,
# and in the anonymous labeling link.
FRONTEND_URL=http://localhost:3000
# Where the browser reaches the API; the frontend fails to start without it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Optional (the values shown are the defaults) ---
# Comma-separated hosts Django accepts.
# DJANGO_ALLOWED_HOSTS=*
# Database address seen by the backend, and the port published on your machine.
# DJANGO_DB_HOST=db
# DJANGO_DB_PORT=5432
# DJANGO_DB_HOST_PORT=5432
# Local LLM (Ollama) used by the tiebreak.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA_IMAGE_CONTEXT_MODEL=llava:7b
